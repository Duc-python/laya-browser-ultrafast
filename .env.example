# Decision backend: "laya" (local open-weights, default) or "typesafe" (hosted Jev API / shim).
DECISION_BACKEND=laya
# In-process Laya. LAYA_MODEL pins a checkpoint (e.g. typed-decisions);
# omit to let the Router pick by script/language. Browser-tuned weights:
# cklxx/laya-browser (see docs). First run downloads from Hugging Face Hub.
LAYA_MODEL=
LAYA_DEVICE=cpu
LAYA_HEAD_MAX_LEN=768
LAYA_MAX_LEN=2048
LAYA_PRELOAD=1
# Legacy hosted path (DECISION_BACKEND=typesafe). TYPESAFE_BASE_URL can point
# to a local shim: `laya-serve` (pip install "laya[serve]") or laya2typesafeapi.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
